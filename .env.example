# -----------------------------------------------------------
# Vector Engine
# -----------------------------------------------------------
# Native run:   http://localhost:8081
# Docker Compose: http://vector-engine:8081
VECTOR_ENGINE_URL=http://localhost:8081

# -----------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------
# "ollama" -> local model, runs on your machine, no API key needed
# "claude" -> hosted Claude API, needs ANTHROPIC_API_KEY
# "gemini" -> hosted Gemini API, needs GEMINI_API_KEY (has a free tier)
LLM_PROVIDER=ollama

# -----------------------------------------------------------
# Ollama (used when LLM_PROVIDER=ollama)
# -----------------------------------------------------------
# Native run:                http://localhost:11434
# Docker Compose (API in a container, Ollama on the host):
#   http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# -----------------------------------------------------------
# Claude API (used when LLM_PROVIDER=claude)
# -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# -----------------------------------------------------------
# Gemini API (used when LLM_PROVIDER=gemini)
# -----------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Verify the model name is still current there too, if this default
# 404s (Google renames/retires models over time).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# -----------------------------------------------------------
# CORS
# -----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:3000
